/************************************ Stages & Pipeline ************************************/

Stage {
  EX_substage_CUSTOM3_I (vuA_CUSTOM3_I),
  EX_substage_CUSTOM3_X (vuA_CUSTOM3_X),
  EX_substage_CUSTOM3_O (vuA_CUSTOM3_O),
  EX_substage_CUSTOM5_I (vuA_CUSTOM5_I),
  EX_substage_CUSTOM5_X (vuA_CUSTOM5_X),
  EX_substage_CUSTOM5_O (vuA_CUSTOM5_O),
  EX_substage_CUSTOM10_I (vuA_CUSTOM10_I),
  EX_substage_CUSTOM10_X (vuA_CUSTOM10_X),
  EX_substage_CUSTOM10_O (vuA_CUSTOM10_O),
  EX_substage_CUSTOM14_I (vuA_CUSTOM14_I),
  EX_substage_CUSTOM14_X (vuA_CUSTOM14_X),
  EX_substage_CUSTOM14_O (vuA_CUSTOM14_O)
}

Pipeline {
  EX_subpipe_CUSTOM3 (EX_substage_CUSTOM3_I -> EX_substage_CUSTOM3_X -> EX_substage_CUSTOM3_O),
  EX_subpipe_CUSTOM5 (EX_substage_CUSTOM5_I -> EX_substage_CUSTOM5_X -> EX_substage_CUSTOM5_O),
  EX_subpipe_CUSTOM10 (EX_substage_CUSTOM10_I -> EX_substage_CUSTOM10_X -> EX_substage_CUSTOM10_O),
  EX_subpipe_CUSTOM14 (EX_substage_CUSTOM14_I -> EX_substage_CUSTOM14_X -> EX_substage_CUSTOM14_O)
}

Stage {
  EX_substage_BASE (
    uA_ALU_RegUpdate,
    uA_ALU_Branch,
    uA_CSR,
    uA_LSU,
    uA_MUL,
    uA_MULH,
    uA_DIV,
    uA_DIVU
  )
}

Pipeline {
  EX_subpipe_BASE (EX_substage_BASE)
}

Stage {
  IF_stage (uA_IFetch, uA_PCGen),
  ID_stage (uA_Decode, uA_JumpDecode, uA_JumpDecodeReg, uA_OF_A, uA_OF_B),
  EX_stage [capacity:2] (
    //uA_ALU_RegUpdate,
    //uA_ALU_Branch,
    //uA_CSR,
    //uA_LSU,
    //uA_MUL,
    //uA_MULH,
    // = XISAAC EX stage =
    EX_subpipe_CUSTOM3,
    EX_subpipe_CUSTOM5,
    EX_subpipe_CUSTOM10,
    EX_subpipe_CUSTOM14,
    // -------------------
    //uA_DIV,
    //uA_DIVU
    EX_subpipe_BASE
  ),
  WB_stage (uA_Memory_R, uA_Memory_W)
}

Pipeline CV32E40PXISAAC_pipeline (IF_stage -> ID_stage -> EX_stage -> WB_stage)

/************************************* External Models *************************************/
TraceValue {rs1, rs2, rd, pc, brTarget, rs2_data}

ConnectorModel regModel (
  link : "models/common/StandardRegisterModel.h"
  trace : {rs1, rs2, rd}
  connectorIn : Xd
  connectorOut : {Xa, Xb}
)

ConnectorModel staBranchPredModel (
  link : "models/common/StaticBranchPredictModel.h"
  trace : {pc, brTarget}
  connectorIn : {Pc_np, Pc_p}
  connectorOut : Pc
)

ConnectorModel perfectBranchPredModel (
  link : "models/common/PerfectBranchPredictModel.h"
  trace : {pc, brTarget}
  connectorIn : {Pc_np, Pc_p}
  connectorOut : Pc
)

ResourceModel divider (
  link: "models/cv32e40p/DividerModel.h"
  trace: rs2_data
)

ResourceModel divider_u (
  link: "models/cv32e40p/DividerUnsignedModel.h"
  trace: rs2_data
)

Model iCacheModel(
  link : "models/cv32e40p/CustomICacheModel.h"
  trace : {pc}
)

Model dCacheModel(
  link : "models/cv32e40p/CustomDCacheModel.h"
  trace : {addr}
)

/*********************************** Instruction Section ***********************************/
InstrGroup {
  Arith_Ra_Rb (add, sub, xor, or, and, slt, sltu, sll, srl, sra),
  Arith_Ra (addi, xori, ori, andi, slti, sltiu, slli, srli, srai),
  Arith_X (auipc, lui),
  Mul_Ra_Rb (mul),
  MulH_Ra_Rb (mulh, mulhu, mulhsu),
  Div_Ra_Rb (div, rem),
  DivU_Ra_Rb (divu, remu),
  Csr_Ra (csrrw, csrrs, csrrc),
  Csr_X (csrrwi, csrrsi, csrrci),
  Store (sb, sh, sw),
  Load (lw, lh, lhu, lb, lbu),
  Branch_Ra_Rb (beq, bne, blt, bge, bltu, bgeu),
  Default ([?])
}

// = XISAAC Instr Groups =
InstrGroup {
  XIsaac_CUSTOM3 (custom3),
  XIsaac_CUSTOM5 (custom5),
  XIsaac_CUSTOM10 (custom10),
  XIsaac_CUSTOM14 (custom14)
}
// -----------------------

MicroactionMapping {
  [ALL] :        {uA_IFetch, uA_PCGen},
  Arith_Ra_Rb :  {uA_Decode, uA_OF_A, uA_OF_B, uA_ALU_RegUpdate},
  Arith_Ra :     {uA_Decode, uA_OF_A, uA_ALU_RegUpdate},
  Arith_X :      {uA_Decode, uA_ALU_RegUpdate},
  Mul_Ra_Rb :    {uA_Decode, uA_OF_A, uA_OF_B, uA_MUL},
  MulH_Ra_Rb :   {uA_Decode, uA_OF_A, uA_OF_B, uA_MULH},
  Div_Ra_Rb :    {uA_Decode, uA_OF_A, uA_OF_B, uA_DIV},
  DivU_Ra_Rb :   {uA_Decode, uA_OF_A, uA_OF_B, uA_DIVU},
  Csr_Ra :       {uA_Decode, uA_OF_A, uA_CSR},
  Csr_X :        {uA_Decode, uA_CSR},
  Store :        {uA_Decode, uA_OF_A, uA_OF_B, uA_LSU, uA_Memory_W},
  Load :         {uA_Decode, uA_OF_A, uA_LSU, uA_Memory_R},
  Branch_Ra_Rb : {uA_Decode, uA_OF_A, uA_OF_B, uA_ALU_Branch},
  jal :          {uA_JumpDecode, uA_ALU_RegUpdate},
  jalr :         {uA_JumpDecodeReg, uA_ALU_RegUpdate}
}

// = XISAAC Microaction Mapping =
MicroactionMapping {
  XIsaac_CUSTOM3 : {uA_Decode, uA_OF_A, uA_OF_B, vuA_CUSTOM3_I, vuA_CUSTOM3_X, vuA_CUSTOM3_O},
  XIsaac_CUSTOM5 : {uA_Decode, uA_OF_A, uA_OF_B, vuA_CUSTOM5_I, vuA_CUSTOM5_X, vuA_CUSTOM5_O},
  XIsaac_CUSTOM10 : {uA_Decode, uA_OF_A, uA_OF_B, vuA_CUSTOM10_I, vuA_CUSTOM10_X, vuA_CUSTOM10_O},
  XIsaac_CUSTOM14 : {uA_Decode, uA_OF_A, uA_OF_B, vuA_CUSTOM14_I, vuA_CUSTOM14_X, vuA_CUSTOM14_O}
}
// ------------------------------


TraceValueMapping {
  [ALL] : {
      pc = "$resolved{$pc}"
  },
  Arith_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },
  Arith_Ra : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}"
  },
  Arith_X : {
    rd  = "$bitfield{rd}"
  },
  Mul_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },
  MulH_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },
  // = XISAAC Trace Value Mapping =
  XIsaac_CUSTOM3 : {
    rd = "$bitfield{rd}",
    rd_data = "$reg{$bitfield{rd}}",

    rs1 = "$bitfield{rs1}",
    rs1_data = "$reg{$bitfield{rs1}}",

    rs2 = "$bitfield{rs2}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },
  XIsaac_CUSTOM5 : {
    rd = "$bitfield{rd}",
    rd_data = "$reg{$bitfield{rd}}",

    rs1 = "$bitfield{rs1}",
    rs1_data = "$reg{$bitfield{rs1}}",

    rs2 = "$bitfield{rs2}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },
  XIsaac_CUSTOM10 : {
    rd = "$bitfield{rd}",
    rd_data = "$reg{$bitfield{rd}}",

    rs1 = "$bitfield{rs1}",
    rs1_data = "$reg{$bitfield{rs1}}",

    rs2 = "$bitfield{rs2}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },
  XIsaac_CUSTOM14 : {
    rd = "$bitfield{rd}",
    rd_data = "$reg{$bitfield{rd}}",

    rs1 = "$bitfield{rs1}",
    rs1_data = "$reg{$bitfield{rs1}}",

    rs2 = "$bitfield{rs2}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },
  // ------------------------------
  Div_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },
  DivU_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },
  Csr_Ra : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}"
  },
  Csr_X : {
    rd  = "$bitfield{rd}"
  },
  Store : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}"
  },
  Load : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}"
  },
  Branch_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    brTarget = "$resolved{$pc + (((int16_t)($bitfield{imm} << 3)) >> 3)}"
  },
  jal : {
    rd = "$bitfield{rd}",
    brTarget = "$resolved{$pc + (((int32_t)($bitfield{imm} << 11)) >> 11)}"
  },
  jalr : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}",
    brTarget = "($reg{$bitfield{rs1}} + $resolved{(((int16_t)($bitfield{imm} << 4)) >> 4)}) & -2U"
  }
}

/**************************************** Variants *****************************************/

// Variant: V0
CorePerfModel CV32E40PXISAAC_crc32_V0 (
  core : "XIsaacCore"
  use Pipeline : CV32E40PXISAAC_pipeline
  use ConnectorModel : {regModel, staBranchPredModel}
  assign Resource : {
    vCUSTOM3_I = V0_CUSTOM3_I,
    vCUSTOM3_X = V0_CUSTOM3_X,
    vCUSTOM3_O = V0_CUSTOM3_O,
    vCUSTOM5_I = V0_CUSTOM5_I,
    vCUSTOM5_X = V0_CUSTOM5_X,
    vCUSTOM5_O = V0_CUSTOM5_O,
    vCUSTOM10_I = V0_CUSTOM10_I,
    vCUSTOM10_X = V0_CUSTOM10_X,
    vCUSTOM10_O = V0_CUSTOM10_O,
    vCUSTOM14_I = V0_CUSTOM14_I,
    vCUSTOM14_X = V0_CUSTOM14_X,
    vCUSTOM14_O = V0_CUSTOM14_O
  }
