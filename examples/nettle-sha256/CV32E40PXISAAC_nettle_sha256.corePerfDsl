  EX_substage_CUSTOM37_O (vuA_CUSTOM37_O)
}

Pipeline {
  EX_subpipe_CUSTOM1 (EX_substage_CUSTOM1_I -> EX_substage_CUSTOM1_X -> EX_substage_CUSTOM1_O),
  EX_subpipe_CUSTOM5 (EX_substage_CUSTOM5_I -> EX_substage_CUSTOM5_X -> EX_substage_CUSTOM5_O),
  EX_subpipe_CUSTOM11 (EX_substage_CUSTOM11_I -> EX_substage_CUSTOM11_X -> EX_substage_CUSTOM11_O),
  EX_subpipe_CUSTOM21 (EX_substage_CUSTOM21_I -> EX_substage_CUSTOM21_X -> EX_substage_CUSTOM21_O),
  EX_subpipe_CUSTOM23 (EX_substage_CUSTOM23_I -> EX_substage_CUSTOM23_X -> EX_substage_CUSTOM23_O),
  EX_subpipe_CUSTOM26 (EX_substage_CUSTOM26_I -> EX_substage_CUSTOM26_X -> EX_substage_CUSTOM26_O),
  EX_subpipe_CUSTOM29 (EX_substage_CUSTOM29_I -> EX_substage_CUSTOM29_X -> EX_substage_CUSTOM29_O),
  EX_subpipe_CUSTOM32 (EX_substage_CUSTOM32_I -> EX_substage_CUSTOM32_X -> EX_substage_CUSTOM32_O),
  EX_subpipe_CUSTOM33 (EX_substage_CUSTOM33_I -> EX_substage_CUSTOM33_X -> EX_substage_CUSTOM33_O),
  EX_subpipe_CUSTOM35 (EX_substage_CUSTOM35_I -> EX_substage_CUSTOM35_X -> EX_substage_CUSTOM35_O),
  EX_subpipe_CUSTOM37 (EX_substage_CUSTOM37_I -> EX_substage_CUSTOM37_X -> EX_substage_CUSTOM37_O)
}

Stage {
  EX_substage_BASE (
    uA_ALU_RegUpdate,
    uA_ALU_Branch,
    uA_CSR,
    uA_LSU,
    uA_MUL,
    uA_MULH,
    uA_DIV,
    uA_DIVU
  )
}

Pipeline {
  EX_subpipe_BASE (EX_substage_BASE)
}

Stage {
  IF_stage (uA_IFetch, uA_PCGen),
  ID_stage (uA_Decode, uA_JumpDecode, uA_JumpDecodeReg, uA_OF_A, uA_OF_B),
  EX_stage [capacity:2] (
    //uA_ALU_RegUpdate,
    //uA_ALU_Branch,
    //uA_CSR,
    //uA_LSU,
    //uA_MUL,
    //uA_MULH,
    // = XISAAC EX stage =
    EX_subpipe_CUSTOM1,
    EX_subpipe_CUSTOM5,
    EX_subpipe_CUSTOM11,
    EX_subpipe_CUSTOM21,
    EX_subpipe_CUSTOM23,
    EX_subpipe_CUSTOM26,
    EX_subpipe_CUSTOM29,
    EX_subpipe_CUSTOM32,
    EX_subpipe_CUSTOM33,
    EX_subpipe_CUSTOM35,
    EX_subpipe_CUSTOM37,
    // -------------------
    //uA_DIV,
    //uA_DIVU
    EX_subpipe_BASE
  ),
  WB_stage (uA_Memory_R, uA_Memory_W)
}

Pipeline CV32E40PXISAAC_pipeline (IF_stage -> ID_stage -> EX_stage -> WB_stage)

/************************************* External Models *************************************/
TraceValue {rs1, rs2, rd, pc, brTarget, rs2_data}

ConnectorModel regModel (
  link : "models/common/StandardRegisterModel.h"
  trace : {rs1, rs2, rd}
  connectorIn : Xd
  connectorOut : {Xa, Xb}
)

ConnectorModel staBranchPredModel (
  link : "models/common/StaticBranchPredictModel.h"
  trace : {pc, brTarget}
  connectorIn : {Pc_np, Pc_p}
  connectorOut : Pc
)

ConnectorModel perfectBranchPredModel (
  link : "models/common/PerfectBranchPredictModel.h"
  trace : {pc, brTarget}
  connectorIn : {Pc_np, Pc_p}
  connectorOut : Pc
)

ResourceModel divider (
  link: "models/cv32e40p/DividerModel.h"
  trace: rs2_data
)

ResourceModel divider_u (
  link: "models/cv32e40p/DividerUnsignedModel.h"
  trace: rs2_data
)

Model iCacheModel(
  link : "models/cv32e40p/CustomICacheModel.h"
  trace : {pc}
)

Model dCacheModel(
  link : "models/cv32e40p/CustomDCacheModel.h"
  trace : {addr}
)

/*********************************** Instruction Section ***********************************/
InstrGroup {
  Arith_Ra_Rb (add, sub, xor, or, and, slt, sltu, sll, srl, sra),
  Arith_Ra (addi, xori, ori, andi, slti, sltiu, slli, srli, srai),
  Arith_X (auipc, lui),
  Mul_Ra_Rb (mul),
  MulH_Ra_Rb (mulh, mulhu, mulhsu),
  Div_Ra_Rb (div, rem),
  DivU_Ra_Rb (divu, remu),
  Csr_Ra (csrrw, csrrs, csrrc),
  Csr_X (csrrwi, csrrsi, csrrci),
  Store (sb, sh, sw),
  Load (lw, lh, lhu, lb, lbu),
  Branch_Ra_Rb (beq, bne, blt, bge, bltu, bgeu),
  Default ([?])
}

// = XISAAC Instr Groups =
InstrGroup {
  XIsaac_CUSTOM1 (custom1),
  XIsaac_CUSTOM5 (custom5),
  XIsaac_CUSTOM11 (custom11),
  XIsaac_CUSTOM21 (custom21),
  XIsaac_CUSTOM23 (custom23),
  XIsaac_CUSTOM26 (custom26),
  XIsaac_CUSTOM29 (custom29),
  XIsaac_CUSTOM32 (custom32),
  XIsaac_CUSTOM33 (custom33),
  XIsaac_CUSTOM35 (custom35),
  XIsaac_CUSTOM37 (custom37)
}
// -----------------------

MicroactionMapping {
  [ALL] :        {uA_IFetch, uA_PCGen},
  Arith_Ra_Rb :  {uA_Decode, uA_OF_A, uA_OF_B, uA_ALU_RegUpdate},
  Arith_Ra :     {uA_Decode, uA_OF_A, uA_ALU_RegUpdate},
  Arith_X :      {uA_Decode, uA_ALU_RegUpdate},
  Mul_Ra_Rb :    {uA_Decode, uA_OF_A, uA_OF_B, uA_MUL},
  MulH_Ra_Rb :   {uA_Decode, uA_OF_A, uA_OF_B, uA_MULH},
  Div_Ra_Rb :    {uA_Decode, uA_OF_A, uA_OF_B, uA_DIV},
  DivU_Ra_Rb :   {uA_Decode, uA_OF_A, uA_OF_B, uA_DIVU},
  Csr_Ra :       {uA_Decode, uA_OF_A, uA_CSR},
  Csr_X :        {uA_Decode, uA_CSR},
  Store :        {uA_Decode, uA_OF_A, uA_OF_B, uA_LSU, uA_Memory_W},
  Load :         {uA_Decode, uA_OF_A, uA_LSU, uA_Memory_R},
  Branch_Ra_Rb : {uA_Decode, uA_OF_A, uA_OF_B, uA_ALU_Branch},
  jal :          {uA_JumpDecode, uA_ALU_RegUpdate},
  jalr :         {uA_JumpDecodeReg, uA_ALU_RegUpdate}
}

// = XISAAC Microaction Mapping =
MicroactionMapping {
  XIsaac_CUSTOM1 : {uA_Decode, uA_OF_A, uA_OF_B, vuA_CUSTOM1_I, vuA_CUSTOM1_X, vuA_CUSTOM1_O},
