/*********************************** Microaction Section ***********************************/
Connector {Pc, Pc_np, Pc_p}
Connector {Xa, Xb, Xd}

Resource {PCGen, Decoder, JumpDecoder, ALU, LSU, CSR}
Resource {MUL, MULH(5)}
Resource {DIV(12), DIVU(12)}
Resource {IPort_R(1), DPort_R(1), DPort_W(1)}

// = XISAAC Resources =
virtual Resource {
  vCUSTOM5_I,
  vCUSTOM5_X,
  vCUSTOM5_O
}

// Variant: V0
Resource {V0_CUSTOM5_I(1), V0_CUSTOM5_X(0), V0_CUSTOM5_O(0)}

// Variant: V1
Resource {V1_CUSTOM5_I(1), V1_CUSTOM5_X(0), V1_CUSTOM5_O(1)}

// Variant: V2
Resource {V2_CUSTOM5_I(1), V2_CUSTOM5_X(1), V2_CUSTOM5_O(1)}

// Variant: V3
Resource {V3_CUSTOM5_I(2), V3_CUSTOM5_X(0), V3_CUSTOM5_O(0)}

// Variant: V4
Resource {V4_CUSTOM5_I(2), V4_CUSTOM5_X(0), V4_CUSTOM5_O(2)}

// Variant: V5
Resource {V5_CUSTOM5_I(2), V5_CUSTOM5_X(2), V5_CUSTOM5_O(2)}

// Variant: V6
Resource {V6_CUSTOM5_I(3), V6_CUSTOM5_X(0), V6_CUSTOM5_O(0)}

// Variant: V7
Resource {V7_CUSTOM5_I(3), V7_CUSTOM5_X(0), V7_CUSTOM5_O(3)}

// Variant: V8
Resource {V8_CUSTOM5_I(3), V8_CUSTOM5_X(3), V8_CUSTOM5_O(3)}
// --------------------

Microaction {
  uA_IFetch        (Pc -> IPort_R),
  uA_PCGen         (Pc -> PCGen -> Pc_p),
  uA_Decode        (Decoder),
  uA_JumpDecode    (JumpDecoder -> Pc_np),
  uA_JumpDecodeReg (Xa -> JumpDecoder -> Pc_np),
  uA_OF_A          (Xa),
  uA_OF_B          (Xb),
  uA_ALU_RegUpdate (ALU -> Xd),
  uA_ALU_Branch    (ALU -> Pc_np),
  uA_CSR           (CSR -> Xd),
  uA_LSU           (LSU),
  uA_MUL           (MUL -> Xd),
  uA_MULH          (MULH -> Xd),
  uA_DIV           (DIV -> Xd),
  uA_DIVU          (DIVU -> Xd),
  uA_Memory_R      (DPort_R -> Xd),
  uA_Memory_W      (DPort_W)
}

// = XISAAC Microactions =
virtual Microaction {
  vuA_CUSTOM5_I,
  vuA_CUSTOM5_X,
  vuA_CUSTOM5_O
}

// Variant: V0
Microaction {
  uA_V0_CUSTOM5_I    (V0_CUSTOM5_I),
  uA_V0_CUSTOM5_X    (V0_CUSTOM5_X),
  uA_V0_CUSTOM5_O    (V0_CUSTOM5_O -> Xd)
}
// Variant: V1
Microaction {
  uA_V1_CUSTOM5_I    (V1_CUSTOM5_I),
  uA_V1_CUSTOM5_X    (V1_CUSTOM5_X),
  uA_V1_CUSTOM5_O    (V1_CUSTOM5_O -> Xd)
}
// Variant: V2
Microaction {
  uA_V2_CUSTOM5_I    (V2_CUSTOM5_I),
  uA_V2_CUSTOM5_X    (V2_CUSTOM5_X),
  uA_V2_CUSTOM5_O    (V2_CUSTOM5_O -> Xd)
}
// Variant: V3
Microaction {
  uA_V3_CUSTOM5_I    (V3_CUSTOM5_I),
  uA_V3_CUSTOM5_X    (V3_CUSTOM5_X),
  uA_V3_CUSTOM5_O    (V3_CUSTOM5_O -> Xd)
}
// Variant: V4
Microaction {
  uA_V4_CUSTOM5_I    (V4_CUSTOM5_I),
  uA_V4_CUSTOM5_X    (V4_CUSTOM5_X),
  uA_V4_CUSTOM5_O    (V4_CUSTOM5_O -> Xd)
}
// Variant: V5
Microaction {
  uA_V5_CUSTOM5_I    (V5_CUSTOM5_I),
  uA_V5_CUSTOM5_X    (V5_CUSTOM5_X),
  uA_V5_CUSTOM5_O    (V5_CUSTOM5_O -> Xd)
}
// Variant: V6
Microaction {
  uA_V6_CUSTOM5_I    (V6_CUSTOM5_I),
  uA_V6_CUSTOM5_X    (V6_CUSTOM5_X),
  uA_V6_CUSTOM5_O    (V6_CUSTOM5_O -> Xd)
}
// Variant: V7
Microaction {
  uA_V7_CUSTOM5_I    (V7_CUSTOM5_I),
  uA_V7_CUSTOM5_X    (V7_CUSTOM5_X),
  uA_V7_CUSTOM5_O    (V7_CUSTOM5_O -> Xd)
}
// Variant: V8
Microaction {
  uA_V8_CUSTOM5_I    (V8_CUSTOM5_I),
  uA_V8_CUSTOM5_X    (V8_CUSTOM5_X),
  uA_V8_CUSTOM5_O    (V8_CUSTOM5_O -> Xd)
}
// -----------------------

/************************************ Stages & Pipeline ************************************/

Stage {
  EX_substage_CUSTOM5_I (vuA_CUSTOM5_I),
  EX_substage_CUSTOM5_X (vuA_CUSTOM5_X),
  EX_substage_CUSTOM5_O (vuA_CUSTOM5_O)
}

Pipeline {
  EX_subpipe_CUSTOM5 (EX_substage_CUSTOM5_I -> EX_substage_CUSTOM5_X -> EX_substage_CUSTOM5_O)
}

Stage {
  EX_substage_BASE (
    uA_ALU_RegUpdate,
    uA_ALU_Branch,
    uA_CSR,
    uA_LSU,
    uA_MUL,
    uA_MULH,
    uA_DIV,
    uA_DIVU
  )
}

Pipeline {
  EX_subpipe_BASE (EX_substage_BASE)
}

Stage {
  IF_stage (uA_IFetch, uA_PCGen),
  ID_stage (uA_Decode, uA_JumpDecode, uA_JumpDecodeReg, uA_OF_A, uA_OF_B),
  EX_stage [capacity:2] (
    //uA_ALU_RegUpdate,
    //uA_ALU_Branch,
    //uA_CSR,
    //uA_LSU,
    //uA_MUL,
    //uA_MULH,
    // = XISAAC EX stage =
    EX_subpipe_CUSTOM5,
    // -------------------
    //uA_DIV,
    //uA_DIVU
    EX_subpipe_BASE
  ),
  WB_stage (uA_Memory_R, uA_Memory_W)
}

Pipeline CV32E40PXISAAC_pipeline (IF_stage -> ID_stage -> EX_stage -> WB_stage)

/************************************* External Models *************************************/
TraceValue {rs1, rs2, rd, pc, brTarget, rs2_data}

ConnectorModel regModel (
  link : "models/common/StandardRegisterModel.h"
  trace : {rs1, rs2, rd}
  connectorIn : Xd
  connectorOut : {Xa, Xb}
)

ConnectorModel staBranchPredModel (
  link : "models/common/StaticBranchPredictModel.h"
  trace : {pc, brTarget}
  connectorIn : {Pc_np, Pc_p}
  connectorOut : Pc
)

ConnectorModel perfectBranchPredModel (
  link : "models/common/PerfectBranchPredictModel.h"
  trace : {pc, brTarget}
  connectorIn : {Pc_np, Pc_p}
  connectorOut : Pc
)

ResourceModel divider (
  link: "models/cv32e40p/DividerModel.h"
  trace: rs2_data
)

ResourceModel divider_u (
  link: "models/cv32e40p/DividerUnsignedModel.h"
  trace: rs2_data
)

Model iCacheModel(
  link : "models/cv32e40p/CustomICacheModel.h"
  trace : {pc}
)

Model dCacheModel(
  link : "models/cv32e40p/CustomDCacheModel.h"
  trace : {addr}
)

/*********************************** Instruction Section ***********************************/
InstrGroup {
  Arith_Ra_Rb (add, sub, xor, or, and, slt, sltu, sll, srl, sra),
  Arith_Ra (addi, xori, ori, andi, slti, sltiu, slli, srli, srai),
  Arith_X (auipc, lui),
  Mul_Ra_Rb (mul),
  MulH_Ra_Rb (mulh, mulhu, mulhsu),
  Div_Ra_Rb (div, rem),
  DivU_Ra_Rb (divu, remu),
  Csr_Ra (csrrw, csrrs, csrrc),
  Csr_X (csrrwi, csrrsi, csrrci),
  Store (sb, sh, sw),
  Load (lw, lh, lhu, lb, lbu),
  Branch_Ra_Rb (beq, bne, blt, bge, bltu, bgeu),
  Default ([?])
}

// = XISAAC Instr Groups =
InstrGroup {
  XIsaac_CUSTOM5 (custom5)
}
// -----------------------

MicroactionMapping {
  [ALL] :        {uA_IFetch, uA_PCGen},
  Arith_Ra_Rb :  {uA_Decode, uA_OF_A, uA_OF_B, uA_ALU_RegUpdate},
  Arith_Ra :     {uA_Decode, uA_OF_A, uA_ALU_RegUpdate},
  Arith_X :      {uA_Decode, uA_ALU_RegUpdate},
  Mul_Ra_Rb :    {uA_Decode, uA_OF_A, uA_OF_B, uA_MUL},
  MulH_Ra_Rb :   {uA_Decode, uA_OF_A, uA_OF_B, uA_MULH},
  Div_Ra_Rb :    {uA_Decode, uA_OF_A, uA_OF_B, uA_DIV},
  DivU_Ra_Rb :   {uA_Decode, uA_OF_A, uA_OF_B, uA_DIVU},
  Csr_Ra :       {uA_Decode, uA_OF_A, uA_CSR},
  Csr_X :        {uA_Decode, uA_CSR},
  Store :        {uA_Decode, uA_OF_A, uA_OF_B, uA_LSU, uA_Memory_W},
  Load :         {uA_Decode, uA_OF_A, uA_LSU, uA_Memory_R},
  Branch_Ra_Rb : {uA_Decode, uA_OF_A, uA_OF_B, uA_ALU_Branch},
  jal :          {uA_JumpDecode, uA_ALU_RegUpdate},
  jalr :         {uA_JumpDecodeReg, uA_ALU_RegUpdate}
}

// = XISAAC Microaction Mapping =
MicroactionMapping {
  XIsaac_CUSTOM5 : {uA_Decode, uA_OF_A, uA_OF_B, vuA_CUSTOM5_I, vuA_CUSTOM5_X, vuA_CUSTOM5_O}
}
// ------------------------------


TraceValueMapping {
  [ALL] : {
      pc = "$resolved{$pc}"
  },
  Arith_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },
  Arith_Ra : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}"
  },
  Arith_X : {
    rd  = "$bitfield{rd}"
  },
  Mul_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },
  MulH_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },
  // = XISAAC Trace Value Mapping =
  XIsaac_CUSTOM5 : {
    rd = "$bitfield{rd}",
    rd_data = "$reg{$bitfield{rd}}",

    rs1 = "$bitfield{rs1}",
    rs1_data = "$reg{$bitfield{rs1}}",

    rs2 = "$bitfield{rs2}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },
  // ------------------------------
  Div_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },
  DivU_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },
  Csr_Ra : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}"
  },
  Csr_X : {
    rd  = "$bitfield{rd}"
  },
  Store : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}"
  },
  Load : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}"
  },
  Branch_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    brTarget = "$resolved{$pc + (((int16_t)($bitfield{imm} << 3)) >> 3)}"
  },
  jal : {
    rd = "$bitfield{rd}",
    brTarget = "$resolved{$pc + (((int32_t)($bitfield{imm} << 11)) >> 11)}"
  },
  jalr : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}",
    brTarget = "($reg{$bitfield{rs1}} + $resolved{(((int16_t)($bitfield{imm} << 4)) >> 4)}) & -2U"
  }
}

/**************************************** Variants *****************************************/

// Variant: V0
CorePerfModel CV32E40PXISAAC_sglib_combined_V0 (
  core : "XIsaacCore"
  use Pipeline : CV32E40PXISAAC_pipeline
  use ConnectorModel : {regModel, staBranchPredModel}
  assign Resource : {
    vCUSTOM5_I = V0_CUSTOM5_I,
    vCUSTOM5_X = V0_CUSTOM5_X,
    vCUSTOM5_O = V0_CUSTOM5_O
  }
  assign Microaction : {
    vuA_CUSTOM5_I = uA_V0_CUSTOM5_I,
    vuA_CUSTOM5_X = uA_V0_CUSTOM5_X,
    vuA_CUSTOM5_O = uA_V0_CUSTOM5_O
  }
)

